# Copy to .env.local and fill with your OWN Supabase project values.
# The anon key is safe in the client (RLS protects data). NEVER put the service_role key here.
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# 'uat' shows the staging sample-profile button + UAT ribbon. Use 'prod' (or unset) in production.
VITE_APP_ENV=uat
